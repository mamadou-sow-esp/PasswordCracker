#!/usr/bin/env bash
#
# Wrapper de lancement de l'outil passwordCracker.
# Compile les sources au besoin, puis exécute l'application avec les arguments
# passés tels quels.
#
#   ./passwordCracker -m DICO  -h 098f6bcd4621d373cade4e832627b4f6
#   ./passwordCracker -m BRUTE -h 098f6bcd4621d373cade4e832627b4f6
#
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT="$DIR/out"

# (Re)compilation si nécessaire.
if [ ! -d "$OUT" ] || [ -n "$(find "$DIR/src" -name '*.java' -newer "$OUT" 2>/dev/null)" ]; then
    mkdir -p "$OUT"
    javac -d "$OUT" $(find "$DIR/src" -name '*.java')
    # On embarque aussi le dictionnaire dans le classpath (fallback ressource).
    cp "$DIR/dictionary.txt" "$OUT/" 2>/dev/null || true
fi

# Exécution depuis la racine du projet pour que dictionary.txt soit trouvé.
cd "$DIR"
java -cp "$OUT" com.passwordcracker.PasswordCracker "$@"
